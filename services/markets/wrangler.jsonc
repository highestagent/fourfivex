{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fourfivex-markets",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  // The only origin allowed to write or open sockets. `pnpm dev` overrides it with localhost.
  "vars": { "APP_ORIGIN": "https://fourfivex.xyz" },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "TradingRoom" }, { "name": "OWNERS", "class_name": "RoomOwner" }]
  },
  "ratelimits": [{ "name": "RATE_LIMIT", "namespace_id": "11001", "simple": { "limit": 60, "period": 60 } }],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TradingRoom"] }, { "tag": "v2", "new_sqlite_classes": ["RoomOwner"] }]
}

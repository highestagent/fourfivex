{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "intuite-markets",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "TradingRoom" }]
  },
  "ratelimits": [{ "name": "RATE_LIMIT", "namespace_id": "11001", "simple": { "limit": 60, "period": 60 } }],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TradingRoom"] }]
}
